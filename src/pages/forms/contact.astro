---
import PageLayout from "../../layouts/PageLayout.astro";
---

<PageLayout>
  <script is:inline>
    function onSubmit(token) {
      document.getElementById("contact-form").submit();
    }
  </script>
  <h1>Contact Me</h1>
  <div class="form-header">
    <div class="linked-in">
      <a href="https://www.linkedin.com/in/alex-husky/" target="_blank"
        >Message me on LinkedIn <i class="fa-brands fa-linkedin"></i></a
      >
    </div>
    <p>-- OR --</p>
    <h2>Fill out the form below.</h2>
  </div>
  <form id="contact-form" action="/api/contact-form" method="POST">
    <fieldset>
      <label for="name">Name <span class="required">- required</span></label>
      <input type="text" name="name" id="name" required autofocus />
    </fieldset>
    <fieldset>
      <label for="email">Email <span class="required">- required</span></label>
      <input type="email" name="email" id="email" required />
    </fieldset>
    <fieldset>
      <label for="phone">Phone Number</label>
      <input type="tel" name="phone" id="phone" />
    </fieldset>
    <fieldset>
      <label for="comment"
        >Comment <span class="required">- required</span></label
      >
      <textarea name="comment" id="comment" required></textarea>
    </fieldset>
    <button
      class="g-recaptcha"
      data-sitekey={import.meta.env.RECAPTCHA_SITE_KEY}
      data-callback="onSubmit">Submit</button
    >
  </form>
</PageLayout>

<style lang="scss">
  $linkedin-color: #0077b5;

  h1 {
    text-align: center;
  }

  .form-header {
    text-align: center;
  }

  .linked-in {
    margin-top: 50px;
    a {
      background-color: #ffff;
      color: var(--primary-background);
      display: block;
      font-size: 22px;
      text-decoration: none;
      margin: 0 auto;
      max-width: 500px;
      width: 100%;
      border-radius: 30px;
      padding: 10px;
      transition: all 0.15s ease-in-out;

      &:hover {
        background-color: $linkedin-color;
        color: #ffff;
      }
    }
  }

  form {
    background-color: #ffff;
    border-radius: 5px;
    padding: 15px;
    color: var(--primary-background);

    button {
      background: var(--secondary-color);
      border: none;
      //   border-radius: 5px;
      box-sizing: border-box;
      color: white;
      cursor: pointer;
      display: block;
      font-size: 20px;
      margin: 15px auto 0;
      padding: 10px;
      width: 100%;

      &:hover {
        background-color: var(--primary-background);
      }
    }
  }

  fieldset {
    border: none;
    display: flex;
    flex-direction: column;
    padding: 0;

    label {
      margin-left: 5px;
      margin-bottom: 5px;
    }

    textarea {
      width: 100%;
      min-height: 250px;
    }
  }

  input,
  textarea {
    font-size: 18px;
    border: none;
    background-color: rgb(248, 248, 248);
    box-shadow: inset 0 1px 5px rgb(105, 105, 105);
    padding: 10px;
    border-radius: 5px;
    margin-bottom: 15px;

    &:focus {
      background-color: white;
      box-shadow: none;
    }
  }

  textarea {
    resize: vertical;
  }
</style>
