---
const activeUser = Astro.locals.user;
if (!activeUser) {
  let message = encodeURI("You must login to access that page!");
  return Astro.redirect("/login?message=" + message);
}

import { MongoClient } from "mongodb";
import PageLayout from "../../layouts/PageLayout.astro";

const uri = import.meta.env.MONGODB_CONNECTION;

const client = new MongoClient(uri);

// Get the database and collection on which to run the operation
const database = client.db("portfoliodb");
const user = database.collection("User");

// Execute query
const userData = await user.find().toArray();
---

<PageLayout>
  <ol class="projects">
    {
      userData.map(({ username }) => (
        <li class="projects__item">
          <h3>{username}</h3>
        </li>
      ))
    }
  </ol>
</PageLayout>
