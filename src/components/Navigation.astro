---
import IndicatedLink from "./IndicatedLink.astro";

const session = Astro.locals.session ?? null;
---

<nav>
  <ul>
    <li>
      <IndicatedLink label="Projects" url="/projects" />
    </li>
    <li>
      <IndicatedLink label="Contact" url="/contact" />
    </li>
    {
      session && (
        <li>
          <form method="post" action="/api/signout">
            <button>Sign out</button>
          </form>
        </li>
      )
    }
  </ul>
</nav>

<style>
  li {
    list-style: none;
  }
</style>
